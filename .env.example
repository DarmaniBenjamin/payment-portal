# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your secrets never reach GitHub.

# Port the payment service listens on
PORT=4000

# The address customers reach this service at (used for pay links and WiPay's return).
# Locally: http://localhost:4000   Live: e.g. https://pay.yourdomain.com
PUBLIC_URL=http://localhost:4000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://payportal:change-me@localhost:5432/payportal_db

# Key used to encrypt stored secrets (WiPay API keys, webhook secrets).
# Generate one with: npm run -s gen:key
# Never change or lose it once real data is stored, or those secrets can't be read.
ENCRYPTION_KEY=

# TESTING ONLY: send WiPay requests to the local mock (npm run mock:wipay).
# Leave empty to use the real WiPay sandbox/live servers.
WIPAY_BASE_URL=
